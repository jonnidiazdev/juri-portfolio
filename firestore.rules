rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /portfolios/{ownerId} {
      allow read, write: if request.auth != null && request.auth.uid == ownerId;
    }

    match /quoteCache/{ownerId} {
      allow read, write: if request.auth != null && request.auth.uid == ownerId;
    }
  }
}
