# CONFIGURACIÓN OPCIONAL - InvertirOnline API
# Solo necesario si no configuras credenciales desde la interfaz

# Credenciales IOL (fallback)
IOL_USER=""
IOL_PASS=""

# Secreto para firmar tokens JWT de sesión IOL (requerido en dev con vercel dev)
JWT_SECRET=""

# Debug mode para IOL (opcional, muestra logs detallados)
DEBUG_IOL=false

# CONFIGURACIÓN OPCIONAL - CoinGecko API
# Deja vacío para usar endpoint gratuito, o agrega tu API key para Pro

# CoinGecko API Key (opcional)
VITE_COINGECKO_API_KEY=""

# CONFIGURACIÓN OPCIONAL - Firebase (Firestore)
# Si completas estos valores, el portfolio se sincroniza en Firestore.
# Si quedan vacíos, la app sigue funcionando con persistencia local.

VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_MEASUREMENT_ID=""

# NOTAS DE SEGURIDAD:
# - Este archivo está en .gitignore y NO se debe subir al repositorio
# - Las credenciales configuradas desde la interfaz tienen prioridad
# - Ver SECURITY.md para más información sobre seguridad
